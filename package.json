{
  "name": "batipromo-dz",
  "version": "1.0.0",
  "description": "Application Web Professionnelle de Promotion Immobilière & Gestion Multi-Chantiers",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"node server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "seed": "node server/seed.js"
  },
  "keywords": [
    "immobilier",
    "btp",
    "chantiers",
    "promotion-immobiliere",
    "algerie",
    "dzd"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "engines": {
    "node": "22.x"
  }
}
