# ==============================================================================
# BATIPROMO DZ - Configuration des Variables d'Environnement
# ==============================================================================

# Port d'écoute de l'application
PORT=5000
NODE_ENV=production

# Clé secrète pour les Tokens JWT de sécurité (à modifier en production)
JWT_SECRET=votre_cle_secrete_ultra_securisee_promo_2026

# Configuration Base de Données :
# 1. Option PostgreSQL (Recommandé en Production / Cloud) :
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/nom_base?sslmode=require
#
# Exemples de DATABASE_URL :
# - Supabase / Neon / Render Cloud : postgresql://user:pass@ep-cool-fog-123.eu-central-1.aws.neon.tech/batipromo?sslmode=require
# - Docker Local : postgresql://batipromo:batipromo_secure_pass_2026@localhost:5432/batipromo_db
#
# 2. Option SQLite (Par défaut si DATABASE_URL n'est pas définie) :
# Si DATABASE_URL est vide ou omise, l'application utilise automatiquement le fichier batipromo.db
